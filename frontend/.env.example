# Copy to .env.local and replace the placeholders with your Supabase project values.
# These VITE_ variables are exposed in the browser: use only the publishable key (or legacy anon key).
# NEVER put a Supabase service_role key or any other secret here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
