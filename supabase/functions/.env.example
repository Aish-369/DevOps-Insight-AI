# Supabase server configuration — placeholder template only.
# Copy to an untracked local file or set these values in the Supabase secret manager.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_REPLACE_WITH_PUBLIC_KEY"}
SUPABASE_SECRET_KEYS={"default":"sb_secret_REPLACE_WITH_SERVER_ONLY_SECRET_KEY"}
# Legacy fallbacks for older local Supabase stacks:
# SUPABASE_ANON_KEY=REPLACE_WITH_LEGACY_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY

# Browser origin used for CORS and invitation links.
APP_BASE_URL=https://YOUR_APP_ORIGIN.example.com

# GitHub App credentials. Keep the private key on the server only.
GITHUB_APP_ID=REPLACE_WITH_APP_ID
GITHUB_APP_SLUG=REPLACE_WITH_APP_SLUG
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_PEM_BODY\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# Alert verification and scheduled-dispatch secrets (use independent random values).
ALERT_VERIFICATION_PEPPER=REPLACE_WITH_LONG_RANDOM_HMAC_PEPPER
ALERT_SCHEDULER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Provider credentials. Configure only providers that the application will use.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=DevOps Insight AI <alerts@example.com>
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# CI failure analysis currently uses deterministic local rules.
# No external AI provider, API key, payment method, or billing is required.
