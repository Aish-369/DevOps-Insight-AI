{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "jose": "npm:jose@6.1.3",
    "fflate": "npm:fflate@0.8.2"
  },
  "tasks": {
    "check": "deno check --all supabase/functions",
    "lint": "deno lint supabase/functions",
    "fmt:check": "deno fmt --check supabase/functions",
    "test": "deno test --allow-env --allow-net supabase/functions/tests"
  }
}
